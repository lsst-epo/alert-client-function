{
    "compilerOptions": {
      "target": "es2016",
      "module": "commonjs",
      "esModuleInterop": true,
      "strict": true,
      "skipLibCheck": true,
      "outDir": "dist",
      "paths": {
        "@/types/*": ["./src/types/*"]
      }
    },
    "include": ["*"],
    "exclude": ["node_modules"]
}